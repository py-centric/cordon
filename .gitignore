# Rust / Cargo build artifacts
/target/
**/*.rs.bk

# Compiled local binaries
/bin/

# Python bytecode & tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.venv/

# Flutter / Dart build caches
flutter_client/.dart_tool/
flutter_client/build/
flutter_client/.flutter-plugins
flutter_client/.flutter-plugins-dependencies

# Ephemeral Cordon build scratch & captures
.cordon-build-tmp/
.opencode/
*.pcap
*.pcapng

# Tea test-runner local history DB (never committed)
tea.db
tea.db-shm
tea.db-wal

# OS & Editor files
.DS_Store
*.swp
