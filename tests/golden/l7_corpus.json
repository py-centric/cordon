{
  "schema_version": 1,
  "rules_version": 2,
  "description": "Golden L7 policy/scanner evasion corpus for Rust (src/l7_policy.rs). Each case feeds {url, method, headers, payload} through the evaluator; body_encoding describes the wire representation of `payload`: identity = raw text, gzip/deflate = compressed on the wire and content-decoded before scanning, base64 = payload IS base64 text wrapping hidden content (scanner must bounded-decode and rescan), gzip-base64 = gzip(base64 text). Rust receives the decoded payload directly (content decompression is adapter-layer) and must pass every case.",
  "profile": {
    "name": "ai-agent",
    "strict_whitelist": true,
    "block_doh": true,
    "inspect_body_secrets": true,
    "allow_streamed_bodies": false,
    "allowed_domains": [
      "api.openai.com",
      "api.anthropic.com",
      "github.com",
      "api.github.com",
      "pypi.org",
      "files.pythonhosted.org",
      "crates.io",
      "static.crates.io",
      "registry.npmjs.org",
      "example.com"
    ],
    "denied_domains": [
      "webhook.site",
      "exfil.badactor.example"
    ],
    "post_allowed_hosts": [
      "api.openai.com",
      "api.anthropic.com"
    ]
  },
  "cases": [
    {
      "id": "C01",
      "description": "Clean JSON POST to an allowlisted LLM API host with post permission is allowed.",
      "url": "https://api.openai.com/v1/chat/completions",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "body_encoding": "identity",
      "payload": "{\"model\": \"gpt-4o\", \"messages\": [{\"role\": \"user\", \"content\": \"hello\"}]}",
      "body_streamed": false,
      "expected_verdict": "ALLOW",
      "expected_rule_id": "DEFAULT_ALLOW"
    },
    {
      "id": "C02",
      "description": "Fine-grained GitHub PAT (github_pat_ prefix) in request body must be blocked.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "body_encoding": "identity",
      "payload": "{\"note\": \"rotate github_pat_11ABCDEFGHijklmnopqrstuv_0123456789abc later\"}",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_GITHUB_PAT"
    },
    {
      "id": "C03",
      "description": "Classic ghp_ PAT in request body must be blocked.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "body_encoding": "identity",
      "payload": "{\"token\": \"ghp_1234567890abcdefghijklmnopqrstuvwx\"}",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_GITHUB_PAT"
    },
    {
      "id": "C04",
      "description": "AWS STS temporary key (ASIA prefix) in body must be blocked.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "body_encoding": "identity",
      "payload": "{\"aws\": \"ASIAZY12ABCD34EFGHIJ\"}",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_AWS_ACCESS_KEY"
    },
    {
      "id": "C05",
      "description": "Lowercase case-variant AKIA key must still be blocked.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "body_encoding": "identity",
      "payload": "{\"aws\": \"akiazy12abcd34efghij\"}",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_AWS_ACCESS_KEY"
    },
    {
      "id": "C06",
      "description": "Whitespace-split classic PAT must be caught by the whitespace-collapsed rescan.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "body_encoding": "identity",
      "payload": "{\"token\": \"ghp_1234 5678 90ab cdef ghij klmn opqr stuv wx\"}",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_GITHUB_PAT"
    },
    {
      "id": "C07",
      "description": "Whitespace and case split AWS key must be caught after whitespace collapse.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "body_encoding": "identity",
      "payload": "{\"aws\": \"a k i a z y 1 2 a b c d 3 4 e f g h i j\"}",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_AWS_ACCESS_KEY"
    },
    {
      "id": "C08",
      "description": "Base64-wrapped OpenAI key must be caught by the bounded base64 decode-and-rescan pass.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "text/plain"},
      "body_encoding": "base64",
      "payload": "eyJub3RlIjoic2stMTIzNDU2Nzg5MGFiY2RlZmdoaWoifQ==",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_OPENAI_KEY"
    },
    {
      "id": "C09",
      "description": "gzip content-encoded body containing an RSA private key must be decoded before scanning.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "application/json", "Content-Encoding": "gzip"},
      "body_encoding": "gzip",
      "payload": "{\"key\": \"-----BEGIN RSA PRIVATE KEY-----\\nMIIEpAIBAAKCAQEA0syY...\"}",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_PRIVATE_KEY_PEM"
    },
    {
      "id": "C10",
      "description": "OpenSSL ENCRYPTED PRIVATE KEY header variant must be blocked.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "text/plain"},
      "body_encoding": "identity",
      "payload": "-----BEGIN ENCRYPTED PRIVATE KEY-----\nMIIFLTBXBgkqhkiG9w0BBQ0wS...",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_PRIVATE_KEY_PEM"
    },
    {
      "id": "C11",
      "description": "Classic PAT leaked through the URL query string must be blocked.",
      "url": "https://api.openai.com/v1/models?key=ghp_1234567890abcdefghijklmnopqrstuvwx",
      "method": "GET",
      "headers": {},
      "body_encoding": "identity",
      "payload": "",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_GITHUB_PAT"
    },
    {
      "id": "C12",
      "description": "JWT leaked through the Authorization header must be blocked.",
      "url": "https://api.openai.com/v1/models",
      "method": "GET",
      "headers": {"Authorization": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.abcdefghij0123456789klmnop"},
      "body_encoding": "identity",
      "payload": "",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_JWT_BEARER"
    },
    {
      "id": "C13",
      "description": "Trailing-dot hostname deny-list bypass (webhook.site.) must still be blocked.",
      "url": "https://webhook.site./collect",
      "method": "POST",
      "headers": {},
      "body_encoding": "identity",
      "payload": "hello",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "DENY_DOMAIN:webhook.site"
    },
    {
      "id": "C14",
      "description": "Uppercase scheme and host with trailing dot must be normalized and denied.",
      "url": "HTTPS://Webhook.Site./collect",
      "method": "POST",
      "headers": {},
      "body_encoding": "identity",
      "payload": "hello",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "DENY_DOMAIN:webhook.site"
    },
    {
      "id": "C15",
      "description": "Whitespace-padded method 'post ' must be normalized to POST and gated on a read-only host.",
      "url": "https://pypi.org/legacy/",
      "method": "post ",
      "headers": {"Content-Type": "text/plain"},
      "body_encoding": "identity",
      "payload": "upload",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "UNAUTHORIZED_MUTATING_METHOD"
    },
    {
      "id": "C16",
      "description": "WebSocket upgrade must be blocked by default even to allowlisted hosts.",
      "url": "https://api.openai.com/v1/realtime",
      "method": "GET",
      "headers": {"Connection": "Upgrade", "Upgrade": "websocket"},
      "body_encoding": "identity",
      "payload": "",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "WEBSOCKET_UPGRADE_BLOCK"
    },
    {
      "id": "C17",
      "description": "Streamed body over the stream_large_bodies threshold is unscannable and must fail closed.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "application/octet-stream"},
      "body_encoding": "identity",
      "payload": "",
      "body_streamed": true,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "STREAMED_BODY_UNSCANNABLE"
    },
    {
      "id": "C18",
      "description": "Environment secret assignment leaked in the body must be blocked.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "text/plain"},
      "body_encoding": "identity",
      "payload": "DATABASE_URL=postgres://admin:hunter2@db.internal:5432/prod",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_ENV_ASSIGNMENT"
    },
    {
      "id": "C19",
      "description": "Clean GET to an allowlisted registry host is allowed.",
      "url": "https://crates.io/api/v1/crates",
      "method": "GET",
      "headers": {"Accept": "application/json"},
      "body_encoding": "identity",
      "payload": "",
      "body_streamed": false,
      "expected_verdict": "ALLOW",
      "expected_rule_id": "DEFAULT_ALLOW"
    },
    {
      "id": "C20",
      "description": "Explicitly denied exfil domain must be blocked before the allow-list check.",
      "url": "https://exfil.badactor.example/upload",
      "method": "POST",
      "headers": {},
      "body_encoding": "identity",
      "payload": "exfiltrated",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "DENY_DOMAIN:exfil.badactor.example"
    },
    {
      "id": "C21",
      "description": "Host outside the allow-list must be blocked with ALLOWLIST_MISS.",
      "url": "https://unknown-cdn.example.net/asset.js",
      "method": "GET",
      "headers": {},
      "body_encoding": "identity",
      "payload": "",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "ALLOWLIST_MISS"
    },
    {
      "id": "C22",
      "description": "Prose camelCase text resembling sk- must NOT false-positive (digit guard on OPENAI rule).",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "text/plain"},
      "body_encoding": "identity",
      "payload": "The task-ManagementSystemOverviewDocumentation needs review before release.",
      "body_streamed": false,
      "expected_verdict": "ALLOW",
      "expected_rule_id": "DEFAULT_ALLOW"
    },
    {
      "id": "C23",
      "description": "deflate content-encoded body containing a classic PAT must be decoded and blocked.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "text/plain", "Content-Encoding": "deflate"},
      "body_encoding": "deflate",
      "payload": "export TOKEN=ghp_1234567890abcdefghijklmnopqrstuvwx",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_GITHUB_PAT"
    },
    {
      "id": "C24",
      "description": "Hyphenated sk-proj style OpenAI key must be blocked.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "body_encoding": "identity",
      "payload": "{\"key\": \"sk-proj-1234-5678-90ab-cdef-ghij-klmn-op\"}",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_OPENAI_KEY"
    },
    {
      "id": "C25",
      "description": "Base64-wrapped fine-grained PAT behind an env assignment must be caught by the base64 pass.",
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "headers": {"Content-Type": "text/plain"},
      "body_encoding": "base64",
      "payload": "U0VDUkVUX1ZBUj0iZ2l0aHViX3BhdF8xMUFCQ0RFRkdIaWprbG1ub3BxcnN0dXZfMDEyMzQ1Njc4OWFiYyI=",
      "body_streamed": false,
      "expected_verdict": "BLOCK",
      "expected_rule_id": "SECRET_GITHUB_PAT"
    }
  ]
}
